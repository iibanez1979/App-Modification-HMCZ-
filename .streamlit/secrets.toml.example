# ─────────────────────────────────────────────────────────────────────
# Copia este archivo como .streamlit/secrets.toml y completa los valores.
# secrets.toml está en .gitignore: NUNCA se sube a GitHub.
# Sin este archivo la app funciona en modo local (carpeta local_data/).
# ─────────────────────────────────────────────────────────────────────

[github]
token = "github_pat_XXXXXXXXXXXXXXXX"        # fine-grained, Contents: Read and write, solo este repo
repo = "iibanez828-droid/App-Modification-HMCZ-"
branch = "data"

# Usuario maestro (el dueño de la app): ve las vistas de administrador y de supervisor.
# Genera esta sección con:  python scripts/users.py master-hash
[master]
username = "iibanez"
name = "Ivan Ibanez"
password_hash = "$2b$12$..."
